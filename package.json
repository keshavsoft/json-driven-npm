{
    "name": "json-driven-npm",
    "version": "1.3.1",
    "description": "Architectural blueprint and reference implementation for building clean, type-safe, JSON-driven NPM clients without folder sprawl.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "bin": {
        "json-driven-npm": "./bin/json-driven-npm.js"
    },
    "files": [
        "bin",
        "src",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "intellisense": "create-intellisense",
        "test": "node --test test/test.js test/usage.js",
        "verify": "create-intellisense && npm test"
    },
    "keywords": [
        "json-driven",
        "architecture",
        "api-client",
        "declarative-api",
        "sdk-pattern"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=20.10"
    },
    "devDependencies": {
        "create-intellisense": "^1.2.1"
    }
}
